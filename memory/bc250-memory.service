[Unit]
Description=BC-250 SMU patch and GDDR6 temperature collector
After=systemd-modules-load.service
# Skip cleanly when the in-kernel bc250_memory driver is loaded: both use SMU
# queue 3 and collide (SMU wedges, fans ramp up). The collector re-checks too.
ConditionPathExists=!/sys/module/bc250_memory

[Service]
Type=simple
User=root
# Unbuffered, so journal timestamps match when each line was written.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -B /opt/bc250-memory/collector.py
RuntimeDirectory=bc250-memory
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
# A host timeout does not cancel firmware execution. Never restart in a loop.
Restart=no
TimeoutStopSec=50

[Install]
WantedBy=multi-user.target
